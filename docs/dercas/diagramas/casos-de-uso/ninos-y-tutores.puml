@startuml
title SCCVI — gestión de niños y tutores
left to right direction
skinparam backgroundColor #F4F8FA
skinparam shadowing false
skinparam actorBorderColor #07556D
skinparam usecaseBorderColor #07556D
skinparam usecaseBackgroundColor #EAF4F6
skinparam ArrowColor #07556D

actor "Administrador\n(ADMIN)" as admin
actor "Personal de salud\n(HEALTH_STAFF)" as staff
actor "Responsable de centro\n(CENTER_MANAGER)" as manager
actor "Tutor con cuenta\n(GUARDIAN)" as guardian

rectangle "SCCVI · niños y tutores" {
  usecase "Registrar niño" as child_create
  usecase "Actualizar o desactivar niño" as child_update
  usecase "Consultar niño" as child_read
  usecase "Registrar tutor" as guardian_create
  usecase "Actualizar o desactivar tutor" as guardian_update
  usecase "Consultar tutor" as guardian_read
  usecase "Asociar tutor con niño" as associate
}

admin --> child_create
staff --> child_create
admin --> child_update
staff --> child_update
admin --> child_read
staff --> child_read
manager --> child_read
guardian --> child_read
admin --> guardian_create
staff --> guardian_create
admin --> guardian_update
staff --> guardian_update
admin --> guardian_read
staff --> guardian_read
manager --> guardian_read
guardian --> guardian_read
admin --> associate
staff --> associate

note bottom of guardian_read
  GUARDIAN consulta su propio perfil.
  El acceso al niño exige asociación explícita.
end note
@enduml
