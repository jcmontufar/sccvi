{
  "name": "sccvi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate",
    "who:validate": "tsx scripts/import-who-growth.ts --validate-only",
    "who:import": "tsx scripts/import-who-growth.ts",
    "vaccination:validate": "tsx scripts/import-vaccination-schedule.ts --validate-only",
    "vaccination:import": "tsx scripts/import-vaccination-schedule.ts",
    "demo:fixtures": "tsx scripts/demo-functional-fixtures.ts load",
    "demo:fixtures:verify": "tsx scripts/demo-functional-fixtures.ts verify",
    "demo:fixtures:clean": "tsx scripts/demo-functional-fixtures.ts clean",
    "openapi:validate": "redocly lint docs/api/openapi.yaml",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "typecheck": "node -e \"require('node:fs').rmSync('.next/dev', { recursive: true, force: true })\" && next typegen && tsc --noEmit",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "exceljs": "^4.4.0",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "server-only": "0.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.47.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
